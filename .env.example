# 이 파일을 .env 로 복사하고 실제 값을 채우세요. .env는 git에 커밋되지 않습니다.

# 랜딩 페이지 구독 폼이 POST하는 곳. 로컬 개발 중엔 subscribe_server.py 를 띄운
# 다음 ngrok으로 터널을 열고(`ngrok http 5055`) 여기에 그 https 주소를 넣으세요.
# 예: SUBSCRIBE_ENDPOINT=https://xxxx.ngrok-free.dev/subscribe
# 상시 배포(Railway/Render 등, 맥북·ngrok 의존 제거)는 DEPLOY.md 참고 — 배포되면
# 여기를 그 주소로 바꾸세요. 예: SUBSCRIBE_ENDPOINT=https://xxxx.up.railway.app/subscribe
SUBSCRIBE_ENDPOINT=http://localhost:5055/subscribe

# subscribe_server.py의 CORS 허용 origin. 비워두면 "*"(로컬 file:// 테스트 허용) —
# 상시 배포 호스트(Railway/Render)에서만 실제 사이트 도메인으로 채우세요.
# 예: CORS_ALLOWED_ORIGIN=https://wehome-market-report.vercel.app
CORS_ALLOWED_ORIGIN=

# 구독 즉시발송용 이메일(Resend API, resend.com에서 발급). 비워두면 실제 발송 없이
# dry-run(로그만 남김)으로 동작합니다. Gmail SMTP는 안 씁니다 — Railway가 아웃바운드
# SMTP(25/465/587)를 막아놔서 실제 배포 환경에서 전부 실패하는 걸 실측으로 확인했습니다.
RESEND_API_KEY=
# wehome.me 도메인을 Resend에서 인증(DNS 레코드 추가)하기 전까지는 이 공유 테스트
# 도메인으로만 보낼 수 있고, Resend 가입 계정 본인 메일로만 실제 도착합니다.
EMAIL_FROM=onboarding@resend.dev
SMTP_FROM_NAME=위홈 공유숙박 마켓리포트

# 이메일 안의 "전체 리포트 보기"·수신거부 링크에 쓰는 실제 배포 주소.
# 8/6 실배포 전까지는 비워두면 임시 플레이스홀더 URL이 들어갑니다.
SITE_BASE_URL=

# 수신거부 링크 위조 방지용 비밀값. 배포 전 반드시 무작위 문자열로 채우세요.
# 예: python3 -c "import secrets; print(secrets.token_hex(32))"
UNSUB_SECRET=

# 네이버 뉴스 검색 API. 없으면 news.py가 자동으로 dry-run(0건)으로 빠집니다.
# wehome-newsletter/newsletter/.env 에 이미 있는 값을 그대로 재사용할 수 있습니다.
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# 한국관광공사 TourAPI(공공데이터포털) 일반 인증키. 없으면 tourism_demand.py의
# 시도/시군구별 방문자수 수집이 자동으로 dry-run({})으로 빠집니다.
TOUR_API_KEY=

# Google Analytics 4 측정 ID(analytics.google.com에서 발급, G-로 시작). 비어 있으면
# 페이지에 GA4 스크립트를 아예 안 넣습니다(로컬 개발 트래픽이 실제 속성에 안 섞이게).
GA4_MEASUREMENT_ID=

# 사이트 곳곳의 "위홈에 호스트로 등록하기" CTA가 연결되는 곳(UTM 파라미터는
# build_site.py::wehome_cta_url이 자동으로 붙임). 실제 호스트 등록/가입 페이지 경로가
# 정해지기 전까지는 비워두면 홈페이지(https://www.wehome.me)로 대체됩니다.
WEHOME_HOST_SIGNUP_URL=
